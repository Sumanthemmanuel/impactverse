# =============================================================================
# Impactverse Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# --- Application ---
APP_NAME=Impactverse
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- Database (PostgreSQL + PostGIS + pgvector) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=impactverse
DATABASE_PASSWORD=impactverse_secret
DATABASE_NAME=impactverse_db
DATABASE_URL=postgresql+asyncpg://impactverse:impactverse_secret@localhost:5432/impactverse_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# --- JWT Authentication ---
JWT_SECRET_KEY=change-this-to-a-very-long-random-secret-key-at-least-64-chars
JWT_REFRESH_SECRET_KEY=change-this-to-another-very-long-random-secret-key-at-least-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File Storage (S3-compatible) ---
STORAGE_BACKEND=local
# For S3:
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_BUCKET_NAME=impactverse-uploads
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=ap-south-1

# Local storage path (when STORAGE_BACKEND=local)
LOCAL_STORAGE_PATH=./uploads

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- AI Models ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.75
DUPLICATE_SIMILARITY_THRESHOLD=0.85

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@impactverse.in
SMTP_TLS=true

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
